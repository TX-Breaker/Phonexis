# Normalise line endings in the repository; Windows tooling gets CRLF on checkout.
* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.json    text
*.md      text

# Binary assets
*.png     binary
*.ico     binary
*.jpg     binary
*.exe     binary
*.dll     binary
