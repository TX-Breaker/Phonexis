<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Phonexis V3 · "Obi" — light jacket.
         The obi is the MetaGroove purple band on the left edge; the jacket is a cool,
         violet-tinted neutral. Keys used from code (converters, dialogs) are kept stable. -->

    <!-- Obi rail -->
    <SolidColorBrush x:Key="Brush.Obi" Color="#6B4092"/>
    <SolidColorBrush x:Key="Brush.ObiFill" Color="#8659B4"/>
    <SolidColorBrush x:Key="Brush.ObiEdge" Color="#E9DCF7"/>
    <SolidColorBrush x:Key="Brush.ObiInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ObiInkMuted" Color="#F3EBFC"/>
    <SolidColorBrush x:Key="Brush.ObiHover" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ObiPressed" Color="#4DFFFFFF"/>

    <!-- Brand accent (primary actions, focus, current selection) -->
    <Color x:Key="BrandColor">#6B4092</Color>
    <SolidColorBrush x:Key="Brush.Brand" Color="#6B4092"/>
    <SolidColorBrush x:Key="Brush.BrandHover" Color="#5D3681"/>
    <SolidColorBrush x:Key="Brush.BrandPressed" Color="#4E2D6D"/>
    <SolidColorBrush x:Key="Brush.BrandSoft" Color="#EDE5F6"/>
    <SolidColorBrush x:Key="Brush.BrandSoftBorder" Color="#D6C4EA"/>
    <SolidColorBrush x:Key="Brush.BrandText" Color="#5E3685"/>
    <SolidColorBrush x:Key="Brush.OnBrand" Color="#FFFFFF"/>

    <!-- Jacket (grounds and surfaces) -->
    <SolidColorBrush x:Key="Brush.WindowBg" Color="#F5F4F8"/>
    <SolidColorBrush x:Key="Brush.Panel" Color="#ECEAF1"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EFEDF3"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E4E1EB"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#0F2A1F3D"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#1C2A1F3D"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E0DDE7"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C5BFD1"/>

    <!-- Ink -->
    <SolidColorBrush x:Key="Brush.Text" Color="#19151F"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5B5566"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#7D7789"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A9A4B3"/>

    <!-- State -->
    <SolidColorBrush x:Key="Brush.Success" Color="#2E7A48"/>
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E2F1E7"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9E5B00"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FAEFDB"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#BE3328"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE7E5"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#2B5FB4"/>
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E4ECF9"/>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C"/>

    <!-- Media and loading -->
    <SolidColorBrush x:Key="Brush.ThumbnailBg" Color="#E1DDE8"/>
    <SolidColorBrush x:Key="Brush.Scrim" Color="#C7140F1A"/>
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E7E4ED"/>
    <Color x:Key="Color.Shimmer">#B3FFFFFF</Color>
    <Color x:Key="Color.Shadow">#2A1A3D</Color>
    <SolidColorBrush x:Key="Brush.DropOverlay" Color="#E66B4092"/>
</ResourceDictionary>
