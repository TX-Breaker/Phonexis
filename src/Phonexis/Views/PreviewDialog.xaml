<Window x:Class="Phonexis.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Phonexis.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource Window.Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Source={x:Static services:I18n.Instance}, Path=[PvTitle], Mode=OneWay}"
        Width="960" Height="680" MinWidth="640" MinHeight="460">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Player -->
        <Border CornerRadius="8" Background="Black" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="Player" DefaultBackgroundColor="Black"/>
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Background="#33FFFFFF"/>
                    <TextBlock x:Name="LoadingText" Foreground="#CCFFFFFF" FontSize="12.5" Margin="0,12,0,0"
                               TextAlignment="Center"
                               Text="{Binding Source={x:Static services:I18n.Instance}, Path=[PvLoading], Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video info and actions -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="VideoTitle" Style="{StaticResource Text.H2}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VideoMeta" Style="{StaticResource Text.Data}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Ghost}" Tag="&#xE8A7;" Margin="0,0,8,0" Click="OpenBrowser_Click"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[OpenInBrowser], Mode=OneWay}"/>
                <Button Style="{StaticResource Button.Large}" Tag="&#xE73E;" Click="Select_Click" IsDefault="True"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[PvSelect], Mode=OneWay}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
