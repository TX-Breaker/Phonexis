<Window x:Class="Phonexis.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Phonexis.Services"
        Style="{StaticResource Window.Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Phonexis"
        Width="440" SizeToContent="Height" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Obi band -->
        <Border Background="{DynamicResource Brush.Obi}">
            <TextBlock Text="PHONEXIS" FontFamily="{StaticResource Font.Data}" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.ObiInk}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <StackPanel Grid.Column="1" Margin="28,12,28,24">
            <Image Source="/Resources/Images/logo.png" Width="56" Height="56" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Phonexis" Style="{StaticResource Text.H1}" FontSize="26" Margin="0,16,0,0"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Data}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.BrandText}" Margin="0,2,0,0"/>
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,4"
                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[AboutText], Mode=OneWay}"/>
            <TextBlock Style="{StaticResource Text.Secondary}"
                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[AboutCredits], Mode=OneWay}"/>
            <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-8,12,0,0" Click="GitHub_Click"
                    Tag="&#xE71B;"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[AboutGitHub], Mode=OneWay}"/>
            <Border Style="{StaticResource Hairline}" Margin="0,14,0,12"/>
            <Grid>
                <TextBlock Text="© 2026 TX-Breaker · MIT License" Style="{StaticResource Text.Data}" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" MinWidth="96" IsCancel="True"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[Close], Mode=OneWay}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
