<Window x:Class="Phonexis.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Phonexis.Services"
        xmlns:h="clr-namespace:Phonexis.Helpers"
        Style="{StaticResource Window.Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Source={x:Static services:I18n.Instance}, Path=[SettingsTitle], Mode=OneWay}"
        Width="720" Height="680" MinWidth="620" MinHeight="520">

    <Window.Resources>
        <!-- One setting = label + hint on the left, control on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="18,14"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <Border Grid.Row="0" Style="{StaticResource SegmentTrack}" Margin="0,4,0,18">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource SegmentRadio}" IsChecked="True"
                             Checked="Tab_Changed"
                             Content="{Binding Source={x:Static services:I18n.Instance}, Path=[TabGeneral], Mode=OneWay}"/>
                <RadioButton x:Name="TabKeys" Style="{StaticResource SegmentRadio}" Checked="Tab_Changed"
                             Content="{Binding Source={x:Static services:I18n.Instance}, Path=[TabApiKeys], Mode=OneWay}"/>
                <RadioButton x:Name="TabCache" Style="{StaticResource SegmentRadio}" Checked="Tab_Changed"
                             Content="{Binding Source={x:Static services:I18n.Instance}, Path=[TabCache], Mode=OneWay}"/>
                <RadioButton x:Name="TabDownload" Style="{StaticResource SegmentRadio}" Checked="Tab_Changed"
                             Content="{Binding Source={x:Static services:I18n.Instance}, Path=[TabDownload], Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- ===== General ===== -->
        <ScrollViewer Grid.Row="1" x:Name="PanelGeneral" VerticalScrollBarVisibility="Auto" h:Motion.Entrance="Rise">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[LanguageLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="LanguageCombo" Width="200" HorizontalAlignment="Right"
                                      SelectionChanged="Language_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[ThemeLabel], Mode=OneWay}"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystemRadio" Style="{StaticResource SegmentRadio}"
                                                 Checked="Theme_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[ThemeSystem], Mode=OneWay}"/>
                                    <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource SegmentRadio}"
                                                 Checked="Theme_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[ThemeLight], Mode=OneWay}"/>
                                    <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource SegmentRadio}"
                                                 Checked="Theme_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[ThemeDark], Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[ResultsPerSearch], Mode=OneWay}"/>
                            <ComboBox x:Name="MaxResultsCombo" Width="96" HorizontalAlignment="Right"
                                      SelectionChanged="MaxResults_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[SearchEngineLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="SearchModeCombo" Width="200" HorizontalAlignment="Right"
                                      SelectionChanged="SearchMode_Changed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="18,0,18,14" TextWrapping="Wrap"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[SearchEngineHint], Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <CheckBox x:Name="TestModeCheck" Style="{StaticResource CheckBox.Switch}" Margin="18,14"
                                  Checked="Modes_Changed" Unchecked="Modes_Changed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[TestMode], Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[TestModeHint], Mode=OneWay}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Hairline}"/>
                        <CheckBox x:Name="PreselectCheck" Style="{StaticResource CheckBox.Switch}" Margin="18,14"
                                  Checked="Modes_Changed" Unchecked="Modes_Changed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[PsSetting], Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[PsSettingHint], Mode=OneWay}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Hairline}"/>
                        <CheckBox x:Name="CacheOnlyCheck" Style="{StaticResource CheckBox.Switch}" Margin="18,14"
                                  Checked="Modes_Changed" Unchecked="Modes_Changed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[CacheOnly], Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[CacheOnlyHint], Mode=OneWay}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== API keys ===== -->
        <Grid Grid.Row="1" x:Name="PanelKeys" Visibility="Collapsed" h:Motion.Entrance="Rise">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Text.Secondary}" Margin="0,0,0,14"
                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[ApiKeysHint], Mode=OneWay}"/>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewKeyBox" Grid.Column="0" Margin="0,0,8,0" KeyDown="NewKeyBox_KeyDown"
                         FontFamily="Consolas"
                         Tag="{Binding Source={x:Static services:I18n.Instance}, Path=[KeyPlaceholder], Mode=OneWay}"/>
                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Click="AddKey_Click" Tag="&#xE710;"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[AddKey], Mode=OneWay}"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                <ListBox x:Name="KeysList" HorizontalContentAlignment="Stretch"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="KeysCountText" Style="{StaticResource Text.Data}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Click="KeyHelp_Click" Tag="&#xE8A7;"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[GetKeyInstructions], Mode=OneWay}"/>
            </Grid>
        </Grid>

        <!-- ===== Cache ===== -->
        <StackPanel Grid.Row="1" x:Name="PanelCache" Visibility="Collapsed" h:Motion.Entrance="Rise">
            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Brush.BrandSoft}"
                            VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE1D3;" FontSize="17"
                                   Foreground="{DynamicResource Brush.BrandText}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CacheStatsText" Style="{StaticResource Text.H2}"/>
                        <TextBlock x:Name="UsageTodayText" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Button Style="{StaticResource Button.Danger}" HorizontalAlignment="Left" Click="ClearCache_Click" Tag="&#xE74D;"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[ClearCache], Mode=OneWay}"/>
        </StackPanel>

        <!-- ===== Download ===== -->
        <ScrollViewer Grid.Row="1" x:Name="PanelDownload" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      h:Motion.Entrance="Rise">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlEngineLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="DownloaderCombo" Width="320" HorizontalAlignment="Right"
                                      SelectionChanged="Downloader_Changed"/>
                        </Grid>
                        <TextBlock x:Name="DownloaderHint" Style="{StaticResource Text.Secondary}" Margin="18,0,18,14"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlDestLabel], Mode=OneWay}"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DestSameRadio" Style="{StaticResource SegmentRadio}" Checked="Destination_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[DlDestSame], Mode=OneWay}"/>
                                    <RadioButton x:Name="DestSubRadio" Style="{StaticResource SegmentRadio}" Checked="Destination_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[DlDestSub], Mode=OneWay}"/>
                                    <RadioButton x:Name="DestCustomRadio" Style="{StaticResource SegmentRadio}" Checked="Destination_Changed"
                                                 Content="{Binding Source={x:Static services:I18n.Instance}, Path=[DlDestCustom], Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlSubfolderLabel], Mode=OneWay}"/>
                            <TextBox x:Name="SubfolderBox" Width="160" HorizontalAlignment="Right" LostFocus="Subfolder_LostFocus"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlCustomLabel], Mode=OneWay}"/>
                            <TextBlock x:Name="CustomFolderText" Grid.Column="1" Style="{StaticResource Text.Secondary}" Margin="16,0,10,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                            <Button Grid.Column="2" Click="CustomFolder_Click"
                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[SelectFolder], Mode=OneWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="18,0,18,14"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlNamingHint], Mode=OneWay}"/>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlExistingLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="ExistingCombo" Width="200" HorizontalAlignment="Right" SelectionChanged="Existing_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <CheckBox x:Name="MatchDatesCheck" Style="{StaticResource CheckBox.Switch}" Margin="18,14"
                                  Checked="MatchDates_Changed" Unchecked="MatchDates_Changed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlMatchDates], Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlMatchDatesHint], Mode=OneWay}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border x:Name="QualityCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlQualityLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="QualityCombo" Width="120" HorizontalAlignment="Right" SelectionChanged="Quality_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlParallelLabel], Mode=OneWay}"/>
                            <ComboBox x:Name="ParallelCombo" Width="80" HorizontalAlignment="Right" SelectionChanged="Parallel_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel x:Name="ToolsPanel">
                        <TextBlock Style="{StaticResource Text.Label}" Margin="18,14,18,2"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[DlToolsLabel], Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Button.Primary}" MinWidth="100" IsCancel="True"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[Close], Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Window>
