<Window x:Class="Phonexis.Views.FilenameExtractorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Phonexis.Services"
        Style="{StaticResource Window.Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Source={x:Static services:I18n.Instance}, Path=[ExtractorTitle], Mode=OneWay}"
        Width="600" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="24,0,24,22">
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,18"
                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[ExtractorHint], Mode=OneWay}"/>

        <!-- Folder -->
        <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,8"
                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[FolderLabel], Mode=OneWay}"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,0" MinHeight="36" Margin="0,0,8,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,1,9,0"
                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <TextBlock x:Name="FolderText" Grid.Column="1" Style="{StaticResource Text.Secondary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Click="BrowseFolder_Click"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[SelectFolder], Mode=OneWay}"/>
        </Grid>

        <CheckBox x:Name="RecursiveCheck" Margin="0,2,0,20" Checked="Options_Changed" Unchecked="Options_Changed"
                  Content="{Binding Source={x:Static services:I18n.Instance}, Path=[IncludeSubfolders], Mode=OneWay}"/>

        <!-- File types -->
        <Grid Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[FileTypes], Mode=OneWay}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Link}" FontSize="12" Click="SelectAll_Click"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[SelectAll], Mode=OneWay}"/>
                <Button Style="{StaticResource Button.Link}" FontSize="12" Click="SelectNone_Click"
                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[SelectNone], Mode=OneWay}"/>
            </StackPanel>
        </Grid>
        <WrapPanel x:Name="ExtensionsPanel" Margin="0,0,0,16"/>

        <!-- Count -->
        <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,20"
                Background="{DynamicResource Brush.BrandSoft}" BorderBrush="{DynamicResource Brush.BrandSoftBorder}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8D6;" FontSize="14" Margin="0,1,10,0"
                           Foreground="{DynamicResource Brush.BrandText}"/>
                <TextBlock x:Name="CountText" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource Brush.BrandText}"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Ghost}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[Cancel], Mode=OneWay}"/>
            <Button x:Name="SaveTxtButton" MinWidth="120" Margin="0,0,8,0" Click="SaveTxt_Click" Tag="&#xE74E;"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[SaveAsTxt], Mode=OneWay}"/>
            <Button x:Name="UseButton" Style="{StaticResource Button.Primary}" MinWidth="120" Click="Use_Click" Tag="&#xE768;"
                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[UseDirectly], Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</Window>
