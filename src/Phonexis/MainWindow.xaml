<Window x:Class="Phonexis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Phonexis.Services"
        xmlns:models="clr-namespace:Phonexis.Models"
        xmlns:h="clr-namespace:Phonexis.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Phonexis"
        MinWidth="880" MinHeight="580"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.UI}"
        Background="{DynamicResource Brush.WindowBg}"
        UseLayoutRounding="True"
        h:WindowChromeHelper.Enable="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        DragEnter="Window_DragEnter" DragLeave="Window_DragLeave"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Result card metrics; MainWindow.xaml.cs switches them to compact values on a narrow column -->
        <sys:Double x:Key="Result.ThumbWidth">176</sys:Double>
        <sys:Double x:Key="Result.ThumbHeight">99</sys:Double>
        <sys:Double x:Key="Result.SelectMinWidth">112</sys:Double>
        <Visibility x:Key="Result.DescVisibility">Visible</Visibility>
        <GridLength x:Key="Result.ViewsColumn">78</GridLength>
        <GridLength x:Key="Result.DateColumn">80</GridLength>

        <!-- Whole-row button for the queue: no chrome, the container owns hover/current -->
        <Style x:Key="Button.Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="10,8,12,8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"/>
                            <Border x:Name="ov" Background="{DynamicResource Brush.Hover}" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BrandSoft}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="300" MinWidth="230" MaxWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ OBI RAIL ============================ -->
        <Grid Grid.Column="0" Background="{DynamicResource Brush.Obi}" ClipToBounds="True">
            <!-- The obi fills: a lighter band rises with every processed song -->
            <Border Background="{DynamicResource Brush.ObiFill}" h:Motion.Fill="{Binding ProgressFraction}">
                <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource Brush.ObiEdge}" Opacity="0.9"/>
            </Border>
            <!-- Downloads: a thin band on the inner edge rises with the videos on disk -->
            <Border Width="3" HorizontalAlignment="Right" Background="{DynamicResource Brush.ObiEdge}"
                    h:Motion.Fill="{Binding DownloadFraction}" ToolTip="{Binding DownloadStatusText}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Source="/Resources/Images/logo.png" Width="34" Height="34"
                       Margin="0,14,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Button Style="{StaticResource Button.Rail}" Content="&#xE8E5;"
                            Command="{Binding LoadFileCommand}" ToolTip="{Binding L[LoadTxt]}"/>
                    <Button Style="{StaticResource Button.Rail}" Content="&#xE8B7;" Margin="0,4,0,0"
                            Command="{Binding OpenExtractorCommand}" ToolTip="{Binding L[CreateTxt]}"/>
                    <Button Style="{StaticResource Button.Rail}" Content="&#xEDE1;" Margin="0,4,0,0"
                            Command="{Binding ExportCommand}" ToolTip="{Binding L[Export]}"/>
                </StackPanel>

                <!-- Vertical wordmark, set like the spine text of an obi -->
                <TextBlock Grid.Row="2" Text="PHONEXIS" FontFamily="{StaticResource Font.Data}" FontSize="13"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.ObiInkMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!-- Progress counter -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,14" Background="Transparent"
                            ToolTip="{Binding ProgressText}" ToolTipService.Placement="Right"
                            Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProcessedCount}" FontFamily="{StaticResource Font.Data}" FontSize="17"
                               FontWeight="Bold" Foreground="{DynamicResource Brush.ObiInk}"
                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"/>
                    <Border Width="18" Height="1.5" Margin="0,3" Background="{DynamicResource Brush.ObiInk}"/>
                    <TextBlock Text="{Binding Songs.Count}" FontFamily="{StaticResource Font.Data}" FontSize="12"
                               Foreground="{DynamicResource Brush.ObiInk}"
                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button Style="{StaticResource Button.Rail}" Content="&#xE706;"
                            Command="{Binding ToggleThemeCommand}" ToolTip="{Binding L[ThemeToggleTooltip]}"/>
                    <Button Style="{StaticResource Button.Rail}" Content="&#xE713;" Margin="0,4,0,0"
                            Command="{Binding OpenSettingsCommand}" ToolTip="{Binding L[SettingsTooltip]}"/>
                    <Button Style="{StaticResource Button.Rail}" Content="&#xE946;" Margin="0,4,0,0"
                            Command="{Binding OpenAboutCommand}" ToolTip="{Binding L[AboutTooltip]}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================ QUEUE ============================ -->
        <Border Grid.Column="1" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0,18,0" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Text.H2}" Text="{Binding L[QueueTitle]}"/>
                    <TextBlock Style="{StaticResource Text.Data}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,0,2" Text="{Binding SongsLoadedText}"
                               Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="20,8,18,12"
                      Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,1,7,0"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               Visibility="{Binding SourceFileName, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Text="{Binding SourceFileName}"
                               ToolTip="{Binding SourceFileName}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Data}" Margin="10,0,0,0" FontSize="12"
                               Text="{Binding ProgressText}"/>
                </Grid>

                <!-- Empty queue -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="28,0,28,60"
                            h:Motion.Entrance="Fade"
                            Visibility="{Binding HasSongs, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8FD;" FontSize="26"
                               Foreground="{DynamicResource Brush.TextTertiary}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding L[NoFileLoaded]}"
                               TextAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <ListBox x:Name="QueueList" Grid.Row="2" Margin="10,0,6,8"
                         ItemsSource="{Binding Songs}" ItemContainerStyle="{StaticResource QueueItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SongItem}">
                            <Button Style="{StaticResource Button.Row}"
                                    Command="{Binding DataContext.JumpToSongCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="num" Style="{StaticResource Text.Data}" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Top"
                                               Margin="0,1,0,0"
                                               Text="{Binding DisplayNumber, StringFormat={}{0:000}}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="query" Text="{Binding Query}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SelectedTitle}" FontSize="11.5" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SelectedTitle, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>

                                    <!-- Status mark -->
                                    <Grid Grid.Column="2" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="pending" Width="8" Height="8" StrokeThickness="1.5"
                                                 Stroke="{DynamicResource Brush.BorderStrong}"/>
                                        <Border x:Name="done" Width="18" Height="18" CornerRadius="9" Visibility="Collapsed"
                                                Background="{DynamicResource Brush.Brand}">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="9"
                                                       Foreground="{DynamicResource Brush.OnBrand}"/>
                                        </Border>
                                        <TextBlock x:Name="skipped" Style="{StaticResource Text.Icon}" Text="&#xE893;"
                                                   FontSize="11" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Brush.Warning}"/>
                                        <TextBlock x:Name="none" Style="{StaticResource Text.Icon}" Text="&#xE711;"
                                                   FontSize="10" Visibility="Collapsed"
                                                   Foreground="{DynamicResource Brush.Danger}"/>
                                        <Border x:Name="ondisk" Width="18" Height="18" CornerRadius="9" Visibility="Collapsed"
                                                Background="{DynamicResource Brush.Success}" ToolTip="{Binding DownloadedPath}">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="9"
                                                       Foreground="{DynamicResource Brush.Surface}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="num" Property="Foreground" Value="{DynamicResource Brush.BrandText}"/>
                                    <Setter TargetName="num" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="query" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="pending" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="done" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                    <Setter TargetName="pending" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="skipped" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="query" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NoResults">
                                    <Setter TargetName="pending" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="none" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="query" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DownloadState}" Value="Done">
                                    <Setter TargetName="done" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ondisk" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="16,8,16,14"
                      Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="&#xE792;" Command="{Binding SaveListAsCommand}"
                            Content="{Binding L[SaveList]}" FontSize="12.5" Padding="10,0"
                            ToolTip="{Binding L[SaveListHint]}"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Tag="&#xE710;"
                            Command="{Binding NewSessionCommand}"
                            Content="{Binding L[NewSession]}" FontSize="12.5" Padding="10,0"/>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                      ShowsPreview="False" Focusable="False"/>

        <!-- ============================ MAIN ============================ -->
        <Grid Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Search engine picker: free search, API, or both in order. Lives in the star column so it
                     shrinks (ellipsis) before anything else when the main column gets narrow. -->
                <ComboBox Grid.Column="0" Style="{StaticResource ComboBox.TitlePill}" Tag="&#xE721;"
                          HorizontalAlignment="Right" MaxWidth="200" MinWidth="52" Margin="16,0,8,0"
                          WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding SearchModeTooltip}"
                          AutomationProperties.Name="{Binding L[SearchEngineLabel]}"
                          ItemsSource="{Binding SearchModeOptions}"
                          SelectedIndex="{Binding SearchModeIndex, Mode=TwoWay}"/>
                <!-- Quota only matters when the API can be used -->
                <Border Grid.Column="1" Height="26" CornerRadius="13" Padding="10,0,12,0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{Binding SearchesLeftText}"
                        Visibility="{Binding ShowQuotaPill, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEC4A;" FontSize="12" Margin="0,1,7,0"
                                   Foreground="{DynamicResource Brush.BrandText}"/>
                        <TextBlock Style="{StaticResource Text.Data}" FontSize="12" Text="{Binding QuotaText}"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}"/>
                        </Button.Style>
                    </Button>
                    <Button>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Caption}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                        <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Banners -->
            <StackPanel Grid.Row="1" Margin="32,0,32,0">
                <Border CornerRadius="8" Padding="16,12" Margin="0,4,0,8" h:Motion.Entrance="Rise"
                        Background="{DynamicResource Brush.BrandSoft}"
                        BorderBrush="{DynamicResource Brush.BrandSoftBorder}" BorderThickness="1"
                        Visibility="{Binding ShowResumeBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81C;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Brush.BrandText}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding ResumeBannerText}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Margin="14,0,0,0" Tag="&#xE768;"
                                Command="{Binding ResumeCommand}" Content="{Binding L[Resume]}"/>
                        <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0"
                                Command="{Binding DismissResumeCommand}" Content="{Binding L[Dismiss]}"/>
                    </Grid>
                </Border>

                <Border CornerRadius="8" Padding="16,12" Margin="0,4,0,8" h:Motion.Entrance="Rise"
                        Background="{DynamicResource Brush.WarningSoft}"
                        Visibility="{Binding ShowNoApiKeyBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Brush.Warning}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding L[NoApiKeyBanner]}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Margin="14,0,0,0" Tag="&#xE192;"
                                Command="{Binding OpenSettingsCommand}" Content="{Binding L[AddApiKeyButton]}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===================== WELCOME ===================== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="700" Margin="56,24,48,48" HorizontalAlignment="Left" VerticalAlignment="Center"
                            h:Motion.Entrance="Rise">
                    <TextBlock Style="{StaticResource Text.Display}" Text="{Binding L[WelcomeTitle]}"/>
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" LineHeight="21" MaxWidth="580"
                               HorizontalAlignment="Left" Text="{Binding L[WelcomeText]}" Margin="0,12,0,6"/>
                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="-8,0,0,22" Tag="&#xE897;"
                            Command="{Binding OpenOnboardingCommand}" Content="{Binding L[ObHowItWorks]}"/>

                    <!-- Ready to go -->
                    <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14" h:Motion.Entrance="Rise"
                            Visibility="{Binding HasSongs, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource Text.H2}" Text="{Binding SongsLoadedText}"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SourceFileName}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Large}" Tag="&#xE768;"
                                    Command="{Binding StartCommand}" Content="{Binding L[StartSearch]}"/>
                        </Grid>
                    </Border>

                    <!-- The empty sleeve: an obi waiting for its record -->
                    <Grid MinHeight="196">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.Obi}" CornerRadius="10,0,0,10">
                            <TextBlock Text="PHONEXIS" FontFamily="{StaticResource Font.Data}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.ObiInk}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" CornerRadius="0,10,10,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,1">
                            <StackPanel VerticalAlignment="Center" Margin="32,24">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE898;" FontSize="22"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource Brush.BrandText}"/>
                                <TextBlock Style="{StaticResource Text.H2}" Text="{Binding L[DropHint]}" Margin="0,12,0,18"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Primary}" Tag="&#xE8E5;"
                                            Command="{Binding LoadFileCommand}" Content="{Binding L[LoadTxt]}"/>
                                    <Button Margin="8,0,0,0" Tag="&#xE8B7;"
                                            Command="{Binding OpenExtractorCommand}" Content="{Binding L[CreateTxt]}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- How it works, set like a tracklist -->
                    <StackPanel Margin="0,30,0,0">
                        <StackPanel.Resources>
                            <Style x:Key="StepNo" TargetType="TextBlock" BasedOn="{StaticResource Text.Data}">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.BrandText}"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Margin="0,12" h:Motion.Entrance="Rise" h:Motion.Delay="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StepNo}" Text="01"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding L[WelcomeStep1]}"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Margin="0,12" h:Motion.Entrance="Rise" h:Motion.Delay="120">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StepNo}" Text="02"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding L[WelcomeStep2]}"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                        <Grid Margin="0,12" h:Motion.Entrance="Rise" h:Motion.Delay="160">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StepNo}" Text="03"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding L[WelcomeStep3]}"/>
                        </Grid>
                        <Border Style="{StaticResource Hairline}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== RESULTS ===================== -->
            <Grid Grid.Row="2" h:Motion.Entrance="Fade"
                  Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current song -->
                <Grid x:Name="SongHeader" Grid.Row="0" Margin="32,2,32,0" h:Motion.Entrance="Fade">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Catalog line: number / total · original line from the file -->
                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Data}" FontSize="13">
                            <Run Text="{Binding CurrentSong.DisplayNumber, StringFormat={}{0:000}, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="{DynamicResource Brush.BrandText}"/>
                            <Run Text=" / " Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <Run Text="{Binding Songs.Count, Mode=OneWay}" Foreground="{DynamicResource Brush.TextTertiary}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Text="{Binding CurrentSong.OriginalTitle}" ToolTip="{Binding CurrentSong.OriginalTitle}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource DifferentToVis}">
                                    <Binding Path="CurrentSong.OriginalTitle"/>
                                    <Binding Path="CurrentSong.Query"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Text.H1}" Margin="0,10,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="{Binding CurrentSong.Query}" ToolTip="{Binding CurrentQueryHeader}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Button Tag="&#xE72B;" Command="{Binding GoBackCommand}" Content="{Binding L[Back]}"/>
                        <Button Style="{StaticResource Button.IconOutline}" Margin="8,0,0,0" Content="&#xE70F;"
                                Command="{Binding EditQueryCommand}" ToolTip="{Binding L[EditQuery]}"/>
                        <Button Style="{StaticResource Button.IconOutline}" Margin="8,0,0,0" Content="&#xE72C;"
                                Command="{Binding RefreshSearchCommand}" ToolTip="{Binding L[Refresh]}"/>
                        <Button Margin="8,0,0,0" Tag="&#xE893;" Command="{Binding SkipCommand}" Content="{Binding L[Skip]}"/>
                    </StackPanel>
                </Grid>

                <!-- Filters -->
                <WrapPanel Grid.Row="1" Margin="32,18,32,14">
                    <ComboBox Style="{StaticResource ComboBox.Filter}" Margin="0,0,8,4" Tag="{Binding L[FilterDuration]}"
                              SelectedIndex="{Binding FilterDurationIndex}">
                        <ComboBoxItem Content="{Binding L[Any]}"/>
                        <ComboBoxItem Content="{Binding L[DurShort]}"/>
                        <ComboBoxItem Content="{Binding L[DurMedium]}"/>
                        <ComboBoxItem Content="{Binding L[DurLong]}"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource ComboBox.Filter}" Margin="0,0,8,4" Tag="{Binding L[FilterDate]}"
                              SelectedIndex="{Binding FilterDateIndex}">
                        <ComboBoxItem Content="{Binding L[Any]}"/>
                        <ComboBoxItem Content="{Binding L[DateToday]}"/>
                        <ComboBoxItem Content="{Binding L[DateWeek]}"/>
                        <ComboBoxItem Content="{Binding L[DateMonth]}"/>
                        <ComboBoxItem Content="{Binding L[DateYear]}"/>
                        <ComboBoxItem Content="{Binding L[DateOlder]}"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource ComboBox.Filter}" Margin="0,0,14,4" Tag="{Binding L[FilterViews]}"
                              SelectedIndex="{Binding FilterViewsIndex}">
                        <ComboBoxItem Content="{Binding L[Any]}"/>
                        <ComboBoxItem Content="{Binding L[ViewsHigh]}"/>
                        <ComboBoxItem Content="{Binding L[ViewsMedium]}"/>
                        <ComboBoxItem Content="{Binding L[ViewsLow]}"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4"
                                h:Motion.Entrance="Fade"
                                Visibility="{Binding HiddenByFiltersText, Converter={StaticResource NullToVis}}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71C;" FontSize="12" Margin="0,1,6,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding HiddenByFiltersText}"/>
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <!-- Loading: skeleton rows in the exact shape of a result -->
                    <Grid Margin="32,0,32,0" VerticalAlignment="Top"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="Border" x:Key="Bone">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Skeleton}"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding L[Searching]}" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Brush.BrandText}"/>
                            <ItemsControl>
                                <ItemsControl.ItemsSource>
                                    <x:Array Type="{x:Type sys:Int32}">
                                        <sys:Int32>1</sys:Int32>
                                        <sys:Int32>2</sys:Int32>
                                        <sys:Int32>3</sys:Int32>
                                        <sys:Int32>4</sys:Int32>
                                    </x:Array>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="176"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Bone}" Width="176" Height="99" CornerRadius="6"/>
                                                <StackPanel Grid.Column="1" Margin="16,4,0,0">
                                                    <Border Style="{StaticResource Bone}" Height="14" Width="300" MaxWidth="1000"/>
                                                    <Border Style="{StaticResource Bone}" Height="11" Width="140" Margin="0,12,0,0"/>
                                                    <Border Style="{StaticResource Bone}" Height="11" Width="200" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border h:Motion.Shimmer="True" IsHitTestVisible="False" CornerRadius="8"/>
                    </Grid>

                    <!-- Error -->
                    <Border CornerRadius="8" MaxWidth="560" Padding="20,16" Margin="32,0,32,80" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.DangerSoft}" h:Motion.Entrance="Rise"
                            Visibility="{Binding SearchError, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA39;" FontSize="18" Margin="0,0,14,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource Brush.Danger}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SearchError}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Danger}" FontWeight="SemiBold"/>
                                <!-- Why each engine failed: the name carries the line, the reason stays quiet -->
                                <ItemsControl ItemsSource="{Binding SearchErrorDetails}" Margin="0,6,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <Run Text="{Binding Engine, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Brush.Text}"/><Run Text="  "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SearchErrorHint}" TextWrapping="Wrap"
                                           Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextTertiary}"
                                           Visibility="{Binding SearchErrorHint, Converter={StaticResource NullToVis}}"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Button.Primary}" Margin="0,0,6,6" Tag="&#xE721;"
                                            Visibility="{Binding HasAlternativeEngine, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding RetryWithAlternativeCommand}" Content="{Binding RetryWithAlternativeText}"/>
                                    <Button Margin="0,0,6,6" Tag="&#xE72C;" Command="{Binding RefreshSearchCommand}" Content="{Binding L[Refresh]}"/>
                                    <Button Style="{StaticResource Button.Ghost}" Margin="0,0,6,6" Tag="&#xE893;"
                                            Command="{Binding SkipCommand}" Content="{Binding L[Skip]}"/>
                                    <Button Style="{StaticResource Button.Ghost}" Tag="&#xE8AB;" Margin="0,0,6,6"
                                            Visibility="{Binding HasAlternativeEngine, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding PreferAlternativeCommand}" Content="{Binding PreferAlternativeText}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" SizeChanged="ResultsScroll_SizeChanged"
                                  Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Margin="32,0,26,24">
                            <!-- Empty result: teach the way out -->
                            <Border Style="{StaticResource Card}" Padding="28,26" h:Motion.Entrance="Rise"
                                    Visibility="{Binding ShowNoResultsCard, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="22"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                    <TextBlock Style="{StaticResource Text.H2}" Text="{Binding L[NoResults]}" Margin="0,14,0,4"/>
                                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding L[NoResultsHint]}"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource Button.Primary}" Tag="&#xE70F;" Margin="0,0,8,6"
                                                Command="{Binding EditQueryCommand}" Content="{Binding L[EditQuery]}"/>
                                        <!-- Free search found nothing: the API may still know the song -->
                                        <Button Tag="&#xE721;" Margin="0,0,8,6"
                                                Visibility="{Binding CanTryApiOnEmpty, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding TryApiCommand}" Content="{Binding TryApiText}"/>
                                        <Button Tag="&#xE893;" Margin="0,0,8,6"
                                                Command="{Binding SkipCommand}" Content="{Binding L[Skip]}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Results}" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchResult}">
                                        <Grid Margin="0,0,0,10" h:Motion.Entrance="Rise" h:Motion.Stagger="True">
                                            <Border x:Name="card" Style="{StaticResource Card}" Padding="12" Background="{DynamicResource Brush.Surface}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="lift" Y="0"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="shadow" Color="#2A1A3D" BlurRadius="18"
                                                                      ShadowDepth="4" Direction="270" Opacity="0"/>
                                                </Border.Effect>
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                  Command="{Binding DataContext.SelectVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Thumbnail at one fixed scale for direct comparison -->
                                                    <Grid x:Name="thumb" VerticalAlignment="Top" Background="Transparent"
                                                          h:ThumbnailPreview.VideoId="{Binding VideoId}" Cursor="Hand"
                                                          ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[PvTooltip], Mode=OneWay}"
                                                          Width="{DynamicResource Result.ThumbWidth}" Height="{DynamicResource Result.ThumbHeight}">
                                                        <Grid.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.PreviewVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Border Background="{DynamicResource Brush.ThumbnailBg}" CornerRadius="6"/>
                                                        <!-- Rounded corners come from the Grid's clip (set by ThumbnailPreview) -->
                                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToImage}}"
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <!-- The key that picks this result -->
                                                        <Border x:Name="keyBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Margin="6" MinWidth="20" Height="20" CornerRadius="4" Padding="5,0"
                                                                Background="{DynamicResource Brush.Scrim}">
                                                            <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource ShortcutNumber}}"/>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="16,1,14,0">
                                                        <Border x:Name="recChip" Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                                                Margin="0,0,0,6" Visibility="Collapsed" Padding="7,2,8,3"
                                                                Background="{DynamicResource Brush.Brand}" ToolTip="{Binding MatchReasons}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE734;" FontSize="10" Margin="0,1,5,0"
                                                                           Foreground="{DynamicResource Brush.OnBrand}"/>
                                                                <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{DynamicResource Brush.OnBrand}">
                                                                    <Run Text="{Binding Source={x:Static services:I18n.Instance}, Path=[PsRecommended], Mode=OneWay}"/>
                                                                    <Run Text="{Binding MatchScore, Mode=OneWay, StringFormat={}· {0}}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                   LineHeight="19" Foreground="{DynamicResource Brush.Text}"
                                                                   TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}"/>
                                                        <TextBlock Text="{Binding ChannelTitle}" FontSize="12.5" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- Spec line: the obi's fine print, in fixed columns so five results
                                                             read like a tracklist; the running time sits right, tight. -->
                                                        <Grid Margin="0,7,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{DynamicResource Result.ViewsColumn}"/>
                                                                <ColumnDefinition Width="{DynamicResource Result.DateColumn}"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Background="Transparent"
                                                                        Visibility="{Binding ViewCountText, Converter={StaticResource NullToVis}}"
                                                                        ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[ViewsSuffix], Mode=OneWay}">
                                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE890;" FontSize="12"
                                                                           Margin="0,1,5,0" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                                                <TextBlock Style="{StaticResource Text.Data}" Text="{Binding ViewCountText}"
                                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Data}" Text="{Binding PublishedText}"
                                                                       Visibility="{DynamicResource Result.DescVisibility}"/>
                                                            <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                                    Visibility="{DynamicResource Result.DescVisibility}"
                                                                    Background="{Binding Source, Converter={StaticResource SourceToSoftBrush}}">
                                                                <TextBlock FontFamily="{StaticResource Font.Data}" FontSize="10.5" FontWeight="Bold"
                                                                           Foreground="{Binding Source, Converter={StaticResource SourceToBrush}}"
                                                                           Text="{Binding SourceText}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="4" Style="{StaticResource Text.Data}" Margin="10,0,0,0"
                                                                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                                                       HorizontalAlignment="Right" Text="{Binding DurationText}"/>
                                                        </Grid>
                                                        <!-- Description: one line keeps the fixed result scale; the full text opens on demand -->
                                                        <StackPanel Visibility="{DynamicResource Result.DescVisibility}">
                                                            <TextBlock x:Name="desc" Text="{Binding DescriptionLine}" FontSize="12" Margin="0,7,0,0"
                                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="descFull" Text="{Binding Description}" FontSize="12" Margin="0,7,0,0"
                                                                       Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="18"
                                                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                                                            <ToggleButton x:Name="descToggle" Style="{StaticResource Button.Ghost}"
                                                                          HorizontalAlignment="Left" Margin="-6,2,0,0" Padding="6,0"
                                                                          MinHeight="24" FontSize="12" Tag="&#xE70D;"
                                                                          Foreground="{DynamicResource Brush.TextSecondary}"
                                                                          Visibility="{Binding HasLongDescription, Converter={StaticResource BoolToVis}}"
                                                                          Content="{Binding Source={x:Static services:I18n.Instance}, Path=[ShowFullDescription], Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button x:Name="select" Tag="&#xE73E;"
                                                                Command="{Binding DataContext.SelectVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[Select], Mode=OneWay}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                                    <Setter Property="MinWidth" Value="{DynamicResource Result.SelectMinWidth}"/>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE768;" Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.PreviewVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[PvTooltip], Mode=OneWay}"/>
                                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;"
                                                                    Command="{Binding DataContext.OpenVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[OpenInBrowser], Mode=OneWay}"/>
                                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[CopyLink], Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="descToggle" Property="IsChecked" Value="True">
                                                <Setter TargetName="desc" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="descFull" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="descToggle" Property="Tag" Value="&#xE70E;"/>
                                                <Setter TargetName="descToggle" Property="Content"
                                                        Value="{Binding Source={x:Static services:I18n.Instance}, Path=[HideFullDescription], Mode=OneWay}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                <Setter TargetName="recChip" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                                <Setter TargetName="card" Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Brush.BrandSoftBorder}"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lift" Storyboard.TargetProperty="Y">
                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-2" KeySpline="0.23,1 0.32,1"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                                             To="0.13" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="lift" Storyboard.TargetProperty="Y">
                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.23,1 0.32,1"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button HorizontalAlignment="Center" Margin="0,8,0,0" Tag="&#xE70D;"
                                    Command="{Binding LoadMoreCommand}" Content="{Binding L[LoadMore]}"
                                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===================== COMPLETE ===================== -->
            <!-- The finish: the rail is full, the summary wears a horizontal obi, the picks read as a tracklist -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCompleteVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="32,8,32,32" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Text.Display}" Text="{Binding L[DoneTitle]}" h:Motion.Entrance="Rise"/>
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" Text="{Binding L[DoneText]}"
                               Margin="0,8,0,22" h:Motion.Entrance="Rise" h:Motion.Delay="40"/>

                    <Border Background="{DynamicResource Brush.Obi}" CornerRadius="8" h:Motion.Entrance="Rise" h:Motion.Delay="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Brush.ObiFill}" CornerRadius="8,0,0,8" Padding="16,0">
                                <TextBlock Text="PHONEXIS" FontFamily="{StaticResource Font.Data}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.ObiInk}" VerticalAlignment="Center"/>
                            </Border>
                            <WrapPanel Grid.Column="1" Margin="20,14,12,10" VerticalAlignment="Center">
                                <WrapPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource Font.Data}"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.ObiInk}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </WrapPanel.Resources>
                                <StackPanel Orientation="Horizontal" Margin="0,0,26,4">
                                    <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="13" Text="&#xE73E;" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding SummaryPickedText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,26,4">
                                    <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="12" Text="&#xE893;" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding SummarySkippedText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,26,4">
                                    <TextBlock FontFamily="{StaticResource Font.Icon}" FontSize="11" Text="&#xE711;" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding SummaryNoResultsText}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SummarySongsText}" FontWeight="Normal" Margin="0,0,0,4"
                                           Foreground="{DynamicResource Brush.ObiInkMuted}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,18,0,0" h:Motion.Entrance="Rise" h:Motion.Delay="120">
                        <Button Style="{StaticResource Button.Large}" Tag="&#xE896;" Margin="0,0,8,6"
                                Command="{Binding DownloadVideosCommand}" Content="{Binding L[DlDownloadVideos]}"/>
                        <Button Tag="&#xEDE1;" Margin="0,0,8,6" MinHeight="42"
                                Command="{Binding ExportCommand}" Content="{Binding L[Export]}"/>
                        <Button Tag="&#xE8DE;" Margin="0,0,8,6" MinHeight="42"
                                Command="{Binding OpenArchiveCommand}" Content="{Binding L[DlArchive]}"/>
                        <Button Style="{StaticResource Button.Ghost}" Tag="&#xE710;" Margin="0,0,0,6" MinHeight="42"
                                Command="{Binding NewSessionCommand}" Content="{Binding L[NewSession]}"/>
                    </WrapPanel>

                    <!-- What the download button will do, or the run in progress -->
                    <Grid Margin="0,4,0,22" MinHeight="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Style="{StaticResource Text.Data}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding DownloadSetupText}"/>
                            <TextBlock Style="{StaticResource Text.Data}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding DownloadStatusText}"/>
                            <Button Style="{StaticResource Button.Link}" FontSize="12" Margin="6,0,0,0" Tag="&#xE713;"
                                    Command="{Binding OpenSettingsCommand}" Content="{Binding L[DlSettings]}"/>
                            <Button FontSize="12" Margin="10,0,0,0" Padding="10,0" MinHeight="28" Tag="&#xE72C;"
                                    Command="{Binding RetryFailedDownloadsCommand}"
                                    Content="{Binding FailedDownloadCount, Converter={StaticResource RetryLabel}}"
                                    Visibility="{Binding FailedDownloadCount, Converter={StaticResource CountToVis}}"/>
                        </StackPanel>
                        <Grid VerticalAlignment="Center" h:Motion.Entrance="Fade"
                              Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar VerticalAlignment="Center" Maximum="1" Value="{Binding DownloadFraction, Mode=OneWay}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Data}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" Text="{Binding DownloadStatusText}"/>
                            <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" Tag="&#xE71A;"
                                    Command="{Binding CancelDownloadsCommand}" Content="{Binding L[DlCancel]}"/>
                        </Grid>
                    </Grid>

                    <!-- Export preview: the picked video and the exact link that will be written, per catalog number -->
                    <Border Style="{StaticResource Hairline}"/>
                    <ItemsControl ItemsSource="{Binding Songs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SongItem}">
                                <StackPanel h:Motion.Entrance="Rise" h:Motion.Stagger="True" h:Motion.Delay="140">
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Data}" FontSize="12.5" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,1,0,0"
                                                   Text="{Binding DisplayNumber, StringFormat={}{0:000}}"/>
                                        <!-- Download state -->
                                        <Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel x:Name="dlRunning" Orientation="Horizontal" Visibility="Collapsed">
                                                <ProgressBar Width="90" VerticalAlignment="Center" Maximum="1"
                                                             Value="{Binding DownloadProgress, Mode=OneWay}"/>
                                                <TextBlock Style="{StaticResource Text.Data}" FontSize="11.5" Width="36" Margin="8,0,0,0"
                                                           TextAlignment="Right" Text="{Binding DownloadProgress, StringFormat={}{0:P0}}"/>
                                            </StackPanel>
                                            <Border x:Name="dlChip" Style="{StaticResource Badge}" Visibility="Collapsed"
                                                    Background="{DynamicResource Brush.SurfaceAlt}" ToolTip="{Binding DownloadedPath}">
                                                <TextBlock x:Name="dlChipText" FontFamily="{StaticResource Font.Data}" FontSize="10.5"
                                                           FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="q" Text="{Binding Query}" FontSize="13.5"
                                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding SelectedTitle, Converter={StaticResource NullToVisInverted}}"/>
                                            <TextBlock Text="{Binding SelectedTitle}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding SelectedTitle, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Text="{Binding SelectedUrl}" Style="{StaticResource Text.Data}" FontSize="12"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource Brush.BrandText}"
                                                       Visibility="{Binding SelectedUrl, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="3" Width="18" Height="18" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <Border x:Name="done" Width="18" Height="18" CornerRadius="9" Visibility="Collapsed"
                                                    Background="{DynamicResource Brush.Brand}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="9"
                                                           Foreground="{DynamicResource Brush.OnBrand}"/>
                                            </Border>
                                            <TextBlock x:Name="skipped" Style="{StaticResource Text.Icon}" Text="&#xE893;"
                                                       FontSize="11" Visibility="Collapsed" Foreground="{DynamicResource Brush.Warning}"/>
                                            <TextBlock x:Name="none" Style="{StaticResource Text.Icon}" Text="&#xE711;"
                                                       FontSize="10" Visibility="Collapsed" Foreground="{DynamicResource Brush.Danger}"/>
                                        </Grid>
                                    </Grid>
                                    <Border Style="{StaticResource Hairline}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Downloading">
                                        <Setter TargetName="dlRunning" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Queued">
                                        <Setter TargetName="dlChip" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dlChip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                        <Setter TargetName="dlChipText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Setter TargetName="dlChipText" Property="Text" Value="{Binding Source={x:Static services:I18n.Instance}, Path=[DlStateQueued], Mode=OneWay}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Done">
                                        <Setter TargetName="dlChip" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dlChip" Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                        <Setter TargetName="dlChipText" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                        <Setter TargetName="dlChipText" Property="Text" Value="{Binding Source={x:Static services:I18n.Instance}, Path=[DlStateDone], Mode=OneWay}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Sent">
                                        <Setter TargetName="dlChip" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dlChip" Property="Background" Value="{DynamicResource Brush.InfoSoft}"/>
                                        <Setter TargetName="dlChipText" Property="Foreground" Value="{DynamicResource Brush.Info}"/>
                                        <Setter TargetName="dlChipText" Property="Text" Value="{Binding Source={x:Static services:I18n.Instance}, Path=[DlStateSent], Mode=OneWay}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Skipped">
                                        <Setter TargetName="dlChip" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dlChip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                        <Setter TargetName="dlChipText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Setter TargetName="dlChipText" Property="Text" Value="{Binding Source={x:Static services:I18n.Instance}, Path=[DlStateSkipped], Mode=OneWay}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadState}" Value="Failed">
                                        <Setter TargetName="dlChip" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="dlChip" Property="ToolTip" Value="{Binding DownloadError}"/>
                                        <Setter TargetName="dlChip" Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                        <Setter TargetName="dlChipText" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        <Setter TargetName="dlChipText" Property="Text" Value="{Binding Source={x:Static services:I18n.Instance}, Path=[DlStateFailed], Mode=OneWay}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                        <Setter TargetName="done" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter TargetName="skipped" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="q" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="NoResults">
                                        <Setter TargetName="none" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="q" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Status line -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="32,0" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,20,0"
                                Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding L[KbAll]}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE765;" FontSize="13" Margin="0,1,7,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}"/>
                        <TextBlock Style="{StaticResource Text.Data}" FontSize="11.5" Text="{Binding L[KbHint]}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Data}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding SaveIndicatorText}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Dims the window behind an open dialog -->
        <Border x:Name="DialogScrim" Grid.ColumnSpan="4" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#66000000" h:Motion.Entrance="Fade"/>

        <!-- ============================ DROP OVERLAY ============================ -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="4" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource Brush.DropOverlay}" h:Motion.Entrance="Fade">
            <Grid Margin="40">
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="6 5" Stroke="#B3FFFFFF"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE898;" FontSize="40" Foreground="White"/>
                    <TextBlock Text="{Binding L[DropHint]}" FontSize="18" FontWeight="SemiBold" Foreground="White"
                               Margin="0,16,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
